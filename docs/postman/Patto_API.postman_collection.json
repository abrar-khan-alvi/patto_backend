              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{partner_email}}\"\n}"
            },
            "url": "{{base_url}}/couples/{{current_couple_id}}/invitations/"
          }
        },
        {
          "name": "User 2 - Accept Partner Invitation",
          "auth": {
            "type": "bearer",
            "bearer": [
              { "key": "token", "value": "{{partner_access_token}}", "type": "string" }
            ]
