{
  "info": {
    "_postman_id": "66fe0429-b824-4b1f-a6e6-90266df72fd5",
    "name": "Patto API - Manual Test Collection",
    "description": "Manual API test collection for the Patto Django backend. Start with Health, request OTP for User 1 and User 2, paste OTPs into collection variables, then run the flows in order. Export data before account deletion. Account deletion/disconnection removes the previous couple's shared data; remaining-partner reconnect requests should be run only after the deletion job has processed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "user_email", "value": "partner1@example.com" },
    { "key": "partner_email", "value": "partner2@example.com" },
    { "key": "new_partner_email", "value": "new-partner@example.com" },
    { "key": "otp_code", "value": "" },
    { "key": "partner_otp_code", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "partner_access_token", "value": "" },
    { "key": "partner_refresh_token", "value": "" },
    { "key": "current_couple_id", "value": "" },
    { "key": "invitation_id", "value": "" },
    { "key": "invitation_token", "value": "" },
    { "key": "invite_url", "value": "" },
    { "key": "referral_code", "value": "" },
    { "key": "topic_slug", "value": "money" },
    { "key": "topic_session_id", "value": "" },
    { "key": "discussion_thread_id", "value": "" },
    { "key": "pact_id", "value": "" },
    { "key": "pact_version_id", "value": "" },
    { "key": "clause_proposal_id", "value": "" },
