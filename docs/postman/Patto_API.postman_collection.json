  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/"
          }
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "User 1 - Request Login OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"purpose\": \"login\"\n}"
            },
            "url": "{{base_url}}/auth/otp/request/"
          }
        },
        {
          "name": "User 1 - Verify OTP and Save Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.tokens) {",
                  "  pm.collectionVariables.set('access_token', json.tokens.access_token);",
                  "  pm.collectionVariables.set('refresh_token', json.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"purpose\": \"login\",\n  \"code\": \"{{otp_code}}\"\n}"
            },
            "url": "{{base_url}}/auth/otp/verify/"
          }
        },
        {
          "name": "User 2 - Request Login OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{partner_email}}\",\n  \"purpose\": \"login\"\n}"
            },
            "url": "{{base_url}}/auth/otp/request/"
          }
        },
        {
          "name": "User 2 - Verify OTP and Save Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.tokens) {",
                  "  pm.collectionVariables.set('partner_access_token', json.tokens.access_token);",
                  "  pm.collectionVariables.set('partner_refresh_token', json.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{partner_email}}\",\n  \"purpose\": \"login\",\n  \"code\": \"{{partner_otp_code}}\"\n}"
            },
            "url": "{{base_url}}/auth/otp/verify/"
          }
        },
        {
          "name": "User 1 - Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/me/"
          }
        },
        {
          "name": "User 1 - Update Profile",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Partner One\",\n  \"pronouns\": \"they/them\",\n  \"preferred_language\": \"en\",\n  \"timezone\": \"Asia/Dhaka\"\n}"
            },
            "url": "{{base_url}}/me/"
          }
        },
        {
          "name": "User 1 - Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/token/refresh/"
          }
        }
      ]
    },
    {
