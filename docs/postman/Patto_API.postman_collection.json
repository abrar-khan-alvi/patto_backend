          }
        },
        {
          "name": "Create Account Deletion Request - Deletes Old Couple Data When Processed",
          "description": "This creates the deletion request. When the backend deletion job processes it, User 1 sessions are revoked, User 1 is anonymized/deactivated, the old couple and shared couple data are deleted, and User 2 can create a new couple. Export first; stored export payloads are cleared during deletion processing.",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Manual test only.\",\n  \"confirmation_email\": \"{{user_email}}\"\n}"
            },
            "url": "{{base_url}}/account-deletion-requests/"
          }
        },
        {
          "name": "User 2 - Create New Couple After Deletion Job",
          "description": "Run this only after User 1's account deletion request has been processed by the backend deletion job. It proves the remaining partner is no longer connected to the previous partner.",
          "auth": {
            "type": "bearer",
            "bearer": [
              { "key": "token", "value": "{{partner_access_token}}", "type": "string" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('current_couple_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/couples/"
          }
        },
        {
          "name": "User 2 - Invite New Partner After Deletion Job",
          "description": "Run after User 2 creates a fresh couple. This uses the same partner invitation URL process for the new partner.",
          "auth": {
            "type": "bearer",
            "bearer": [
              { "key": "token", "value": "{{partner_access_token}}", "type": "string" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.invitation) pm.collectionVariables.set('invitation_id', json.invitation.id);",
                  "if (json.token) pm.collectionVariables.set('invitation_token', json.token);",
                  "if (json.invite_url) pm.collectionVariables.set('invite_url', json.invite_url);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{new_partner_email}}\"\n}"
            },
            "url": "{{base_url}}/couples/{{current_couple_id}}/invitations/"
          }
        }
      ]
    }
